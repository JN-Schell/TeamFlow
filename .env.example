# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://teamflow:teamflow@localhost:5432/teamflow?schema=public
TEST_DATABASE_URL=postgresql://teamflow:teamflow@localhost:5432/teamflow_test?schema=public

# Docker Compose database credentials (only read by docker-compose.yml)
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=teamflow
POSTGRES_DB=teamflow

# ── API ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
SOCKET_CORS_ORIGIN=http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DISABLED=false
AUTH_RATE_LIMIT_MAX=10

# ── Email ─────────────────────────────────────────────────────────────────────
# Development defaults to a safe log-only transport. For real delivery set
# EMAIL_PROVIDER=smtp and provide SMTP_HOST plus credentials through secrets.
EMAIL_PROVIDER=log
EMAIL_FROM="TeamFlow <no-reply@teamflow.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_WORKER_INTERVAL_MS=30000
EMAIL_BATCH_SIZE=10
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MS=60000

# ── Seed data ─────────────────────────────────────────────────────────────────
SEED_DEMO_PASSWORD=Password123!
